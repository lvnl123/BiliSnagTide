      <!-- Settings -->
      <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="31" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/><TextBlock Text="设置与代理" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20" MaxWidth="890" HorizontalAlignment="Left">
        <TextBlock Text="偏好设置与本地代理" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <GroupBox Header="播放与 PotPlayer"><StackPanel><StackPanel Orientation="Horizontal"><TextBox x:Name="PlayerPathInput" Width="540" ToolTip="PotPlayerMini64.exe 完整路径"/><Button Content="浏览" Click="BrowsePlayer_Click" Margin="10,0,0,0"/><Button Content="自动检测" Click="DetectPlayer_Click"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="ffprobe（可选，用来探测真实分辨率）：" VerticalAlignment="Center"/><TextBox x:Name="FfprobePathInput" Width="390"/><Button Content="浏览" Click="BrowseFfprobe_Click" Margin="10,0,0,0"/></StackPanel><TextBlock Text="播放器将在每次播放前重新解析原始流。若切换为代理链接，则播放器必须在代理运行期间保持连接。" FontSize="12" Foreground="{DynamicResource SubText}" Margin="0,8,0,0"/></StackPanel></GroupBox>
        <GroupBox Header="本地固定流代理（仅 127.0.0.1）"><StackPanel><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="端口：" VerticalAlignment="Center"/><TextBox x:Name="ProxyPortInput" Width="95" Text="18888"/><Button x:Name="ProxyStartButton" Content="启动代理" Style="{StaticResource PrimaryButton}" Margin="14,0,0,0" Click="ProxyStart_Click"/><Button Content="停止代理" Click="ProxyStop_Click"/><Button Content="复制当前代理地址" Click="ProxyCopy_Click"/></StackPanel><CheckBox x:Name="HlsPreferToggle" Content="优先使用 HLS（利于刷新分段并在新请求中切换线路）；关闭则优先 FLV" IsChecked="True" Margin="0,12,0,0"/><TextBlock x:Name="ProxyStatusText" Text="代理未启动" Foreground="{DynamicResource SubText}" Margin="0,8,0,0"/><TextBlock Text="固定代理地址包含本机访问令牌，请不要把导出的本地播放列表公开。服务器仅接受本机请求，不提供公网服务。" TextWrapping="Wrap" Foreground="{DynamicResource SubText}" Margin="0,6,0,0" FontSize="12"/></StackPanel></GroupBox>
        <GroupBox Header="监测与体验"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="收藏检查间隔（秒）：" VerticalAlignment="Center"/><TextBox x:Name="PollInput" Width="85" Text="120"/><TextBlock Text="限量连接诊断（KB）：" VerticalAlignment="Center" Margin="19,0,7,0"/><TextBox x:Name="ProbeLimitInput" Width="85" Text="64"/></StackPanel><CheckBox x:Name="NotificationsToggle" Content="主播开播时显示 Windows 系统托盘通知" IsChecked="True"/><CheckBox x:Name="ClipboardToggle" Content="自动识别剪贴板中的 B站直播间链接（只读取当前本地剪贴板；不会自动开始播放）" IsChecked="True"/><CheckBox x:Name="AutoProbeToggle" Content="解析后对首选线路做一次有限数据的连接诊断（可关闭）" IsChecked="True"/><CheckBox x:Name="TrayToggle" Content="关闭窗口时最小化到托盘，以继续检测开播（托盘右键可退出）" IsChecked="True"/><CheckBox x:Name="StartupToggle" Content="开机自启动（当前 Windows 用户）"/><CheckBox x:Name="DarkToggle" Content="深色模式（高对比度配色）" Click="Theme_Click"/><CheckBox x:Name="ReduceMotionToggle" Content="减少动画（关闭页面滑入、按钮缩放和侧栏宽度过渡）" Click="MotionSettings_Click"/></StackPanel></GroupBox>
        <GroupBox Header="主题与配色 · Theme Studio">
          <StackPanel>
            <TextBlock Text="v4.3 经典配色保持为默认方案。其它预设会更换整个工作区、卡片、导航、按钮、表格及弹幕浮窗的颜色；浅色与深色可分别调整。" TextWrapping="Wrap" Foreground="{DynamicResource SubText}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="打开主题配色编辑器" Style="{StaticResource PrimaryButton}" Click="OpenThemeEditor_Click" Margin="0,0,12,0"/>
              <TextBlock Text="6 套预设 · 74 个颜色角色 · 实时预览 · 导入/导出 · 对比度检查" Foreground="{DynamicResource SubText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Text="提示：关闭编辑器时选择取消可撤回预览；编辑器中保存后会写入当前用户配置。不会改变 Windows 系统配色。" Foreground="{DynamicResource SubText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="软件更新 · GitHub Releases">
          <StackPanel>
            <TextBlock Text="自动检测 GitHub 最新正式版本；不会因普通源码提交或 README 更新而提示。更新永不自动安装。"
                       TextWrapping="Wrap" Foreground="{DynamicResource SubText}" Margin="0,0,0,10"/>
            <TextBlock x:Name="UpdateCurrentVersionText" Text="当前版本：v4.6.0"
                       FontWeight="SemiBold" FontSize="15" Margin="0,0,0,5"/>
            <TextBlock x:Name="UpdateLatestVersionText" Text="尚未检查 GitHub 版本"
                       Foreground="{DynamicResource SubText}" Margin="0,0,0,10"/>
            <CheckBox x:Name="UpdateAutoToggle" Content="启动后自动检查更新（最多每 24 小时一次）"
                      IsChecked="True" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,9">
              <Button x:Name="UpdateCheckButton" Content="检查更新" Click="UpdateCheck_Click" Margin="0,0,8,8"/>
              <Button x:Name="UpdateDownloadButton" Content="软件内下载" Click="UpdateDownload_Click"
                      Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,8"/>
              <Button x:Name="UpdateGitHubButton" Content="前往 GitHub" Click="UpdateGitHub_Click" Margin="0,0,8,8"/>
              <Button x:Name="UpdateApplyButton" Content="安装 / 应用更新" Click="UpdateApply_Click"
                      IsEnabled="False" Margin="0,0,8,8"/>
              <Button x:Name="UpdateCancelButton" Content="取消下载" Click="UpdateCancel_Click"
                      IsEnabled="False" Margin="0,0,8,8"/>
              <Button x:Name="UpdateSkipButton" Content="跳过此版本" Click="UpdateSkip_Click"
                      IsEnabled="False" Margin="0,0,8,8"/>
            </WrapPanel>
            <ProgressBar x:Name="UpdateProgress" Height="9" Minimum="0" Maximum="100"
                         Visibility="Collapsed" Margin="0,0,0,9"/>
            <TextBlock x:Name="UpdateStatusText" Text="点击「检查更新」获取最新版本与更新日志。"
                       Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
              <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="UpdateNotesText" Text="尚无更新说明。"
                           Foreground="{DynamicResource MainText}" TextWrapping="Wrap" FontSize="12"/>
              </ScrollViewer>
            </Border>
            <TextBlock Text="下载后将检查 SHA-256；只有你确认时才会执行。绿色版退出后替换 EXE；安装版启动新版安装器。未签名程序可能触发 Windows 安全提示。"
                       TextWrapping="Wrap" Foreground="{DynamicResource SubText}" FontSize="12"/>
          </StackPanel>
        </GroupBox>
        <Button Content="保存全部设置" Style="{StaticResource PrimaryButton}" Width="160" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
      </StackPanel></ScrollViewer></TabItem>
      <!-- Diagnostics -->
      <TabItem>
        <TabItem.Header><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/><TextBlock Text="诊断日志" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header>
        <Grid Margin="24,20">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="运行记录与诊断日志" FontSize="23" FontWeight="SemiBold"/>
              <TextBlock x:Name="LogFollowStatus" Text="正在跟随最新日志 · 每 2 秒检查更新" FontSize="12" Foreground="{DynamicResource SubText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="刷新日志" Click="LogRefresh_Click"/>
              <Button Content="打开日志文件夹" Click="LogFolder_Click"/>
              <Button Content="复制诊断摘要" Click="CopyDiagnostics_Click" Margin="0"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="LogAutoFollowToggle" Content="自动跟随最新日志" IsChecked="True" Checked="LogAutoFollow_Changed" Unchecked="LogAutoFollow_Changed" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <Button Content="回到最新" Click="LogToBottom_Click"/>
              <TextBlock Text="手动上翻暂停跟随，回到底部自动恢复" Style="{StaticResource SoftCaption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="10">
            <TextBox x:Name="LogText" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" Padding="12,10" BorderThickness="0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Top" Background="Transparent"/>
          </Border>
          <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="日志会对直播源 URL 的查询参数脱敏，不会保存签名源地址；分享诊断时请优先使用「复制诊断摘要」。" TextWrapping="Wrap" Foreground="{DynamicResource SubText}"/>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="21,3">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource StatusIndicator}" VerticalAlignment="Center" Margin="0,0,9,0"/>
          <TextBlock x:Name="StatusText" Text="已就绪 · 直播源链接可能随时间失效，播放前建议重新解析" FontSize="12" Foreground="{DynamicResource StatusBarFg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="112" Height="4" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
