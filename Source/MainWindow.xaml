<Window x:Class="BiliLiveManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BiliSnagTide — Live Source &amp; Danmaku" Icon="App.ico"
        Width="1440" Height="860" MinWidth="1050" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
  <Window.Resources>
    <Style x:Key="SidebarItemStyle" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource NavText}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Margin" Value="10,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Grid ClipToBounds="True">
          <Border x:Name="NavSurface" CornerRadius="8" Padding="12,0" Background="Transparent">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
          </Border>
          <Border x:Name="ActiveRail" Background="{DynamicResource NavIndicator}" CornerRadius="2" Width="3" Height="20"
                  VerticalAlignment="Center" HorizontalAlignment="Left" Opacity="0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource NavSelected}"/><Setter TargetName="ActiveRail" Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource NavActiveText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
          </Trigger>
          <MultiTrigger><MultiTrigger.Conditions>
            <Condition Property="IsMouseOver" Value="True"/>
            <Condition Property="IsSelected" Value="False"/>
          </MultiTrigger.Conditions>
            <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource NavHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource NavText}"/>
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource MainText}"/>
    </Style>
    <!-- DataGridCell.Padding alone does not pad a generated TextBlock. Explicit inner margin is required. -->
    <Style x:Key="ReadableGridText" TargetType="TextBlock">
      <Setter Property="Margin" Value="14,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="SoftCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource PageBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="70"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>
    <!-- Command bar: brand, room locator, and account actions are visually distinct. -->
    <Border Grid.Row="0" Background="{DynamicResource TopBarBg}" BorderBrush="{DynamicResource TopBarBorder}" BorderThickness="0,0,0,1">
      <Grid Margin="18,0,18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="198"/>
          <ColumnDefinition Width="*" MinWidth="170"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource BrandMarkBg}" Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0">
            <Grid><TextBlock Text="≋" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource BrandMarkFg}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-7,0,0"/></Grid>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="BiliSnagTide" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource HeaderText}"/>
            <TextBlock Text="LIVE SOURCE &amp; DANMAKU" FontSize="12" Foreground="{DynamicResource HeaderMuted}" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
          <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource TopBarBorder}" BorderThickness="1" CornerRadius="8"/>
          <TextBox x:Name="RoomInput" KeyDown="RoomInput_KeyDown" ToolTip="输入 B站直播间号或直播链接"
                   MinHeight="38" Margin="2" Padding="12,7" BorderThickness="0" Background="Transparent" FontSize="13"/>
          <TextBlock Text="粘贴房间号，或 live.bilibili.com 链接" IsHitTestVisible="False"
                     VerticalAlignment="Center" Margin="13,0" FontSize="12" Foreground="{DynamicResource SubText}">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
              <DataTrigger Binding="{Binding ElementName=RoomInput, Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <Button Grid.Column="2" x:Name="PasteButton" Content="粘贴" Click="Paste_Click" VerticalAlignment="Center" Height="38" MinHeight="38"/>
        <Button Grid.Column="3" x:Name="FetchButton" Content="解析直播源" Click="Fetch_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Height="38" MinHeight="38"/>
        <Button Grid.Column="4" Content="取消" Click="Cancel_Click" VerticalAlignment="Center" Height="38" MinHeight="38" Margin="0,0,12,0"/>
        <Border Grid.Column="5" BorderBrush="{DynamicResource TopBarBorder}" BorderThickness="1,0,0,0" Padding="12,0,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="ConnectionText" Text="就绪" Foreground="{DynamicResource HeaderMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="扫码登录" Click="BiliLogin_Click" Style="{StaticResource QuietButton}" Height="38" MinHeight="38"/>
            <Button Content="浏览器打开" Click="OpenRoom_Click" Style="{StaticResource QuietButton}" Height="38" MinHeight="38" Margin="0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <TabControl x:Name="Pages" Grid.Row="1" TabStripPlacement="Left" Background="{DynamicResource PageBg}" BorderThickness="0"
                ItemContainerStyle="{StaticResource SidebarItemStyle}" SelectionChanged="Pages_SelectionChanged">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="SidebarPane" Grid.Column="0" Width="226" ClipToBounds="True" Background="{DynamicResource SidebarBg}"
                    BorderBrush="{DynamicResource NavBorder}" BorderThickness="0,0,1,0">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="11,15,11,12">
                  <Grid Height="40">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="SidebarToggleButton" Width="40" Height="38" Padding="0"
                            Click="SidebarToggle_Click" ToolTip="收起 / 展开导航菜单"
                            AutomationProperties.Name="收起或展开导航菜单"
                            Style="{StaticResource SidebarToggleStyle}">
                      <TextBlock x:Name="SidebarToggleGlyph" Text="☰" FontFamily="Segoe UI Symbol"
                                 FontSize="17" Foreground="{DynamicResource NavText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock x:Name="SidebarTitle" Grid.Column="1" Text="导航菜单" Margin="12,0,0,0"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource NavText}" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock x:Name="SidebarSectionLabel" Text="WORKSPACE" FontSize="12" Foreground="{DynamicResource NavMuted}"
                             FontWeight="SemiBold" Margin="10,16,0,0"/>
                </StackPanel>
                <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="20,14,16,17">
                  <Border Height="1" Background="{DynamicResource NavBorder}" Margin="0,0,0,14"/>
                  <TextBlock Text="BILISNAGTIDE  /  v4.5.2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource NavText}"/>
                  <TextBlock Text="Windows · .NET 8" FontSize="12" Foreground="{DynamicResource NavMuted}" Margin="0,5,0,0"/>
                </StackPanel>
                <TabPanel IsItemsHost="True" Margin="0,0,0,0" KeyboardNavigation.TabIndex="1"/>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource PageBg}">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <!-- SOURCE WORKSPACE: one restrained command hierarchy and one flexible table. -->
      <TabItem x:Name="MainTab">
        <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="30" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/><TextBlock Text="直播源" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header>
        <Grid Margin="24,19,24,18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="190"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="直播源工作区" Style="{StaticResource DisplayHeading}"/>
              <TextBlock Text="解析直播源、查看可用画质，并交给 PotPlayer 播放" Foreground="{DynamicResource SubText}" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="7" Padding="11,6" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource BlueBrush}" Margin="0,0,8,0"/><TextBlock Text="Source Explorer" Foreground="{DynamicResource BlueBrush}" FontWeight="SemiBold" FontSize="12"/></StackPanel>
            </Border>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="18,15" Margin="0,0,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="112" Height="76" CornerRadius="8" Background="{DynamicResource AccentSoft}" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Center"><Image x:Name="RoomCover" Stretch="UniformToFill"/></Border>
              <StackPanel Grid.Column="1" Margin="2,0,18,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentSoft}" ClipToBounds="True" Margin="0,0,9,0"><Image x:Name="RoomAvatar" Stretch="UniformToFill"/></Border>
                  <TextBlock x:Name="RoomTitle" Text="尚未载入直播间" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="RoomOwner" Text="输入房间号或链接，开始解析直播源" FontSize="12.5" Foreground="{DynamicResource SubText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="RoomStatus" Text="等待获取直播状态" FontSize="12" Foreground="{DynamicResource SubText}" Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="☆ 收藏" Click="Favorite_Click" Margin="0,0,0,7" MinWidth="100"/><Button Content="画质诊断" Click="QualityDiagOpen_Click" Margin="0" MinWidth="100"/></StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="0" Margin="0,0,0,14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="18,13,18,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="直播线路" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Foreground="{DynamicResource BlueBrush}" FontSize="12" FontWeight="SemiBold"><Run Text="{Binding ElementName=StreamGrid, Path=Items.Count, Mode=OneWay}"/><Run Text=" 条"/></TextBlock>
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="双击线路直接播放" Style="{StaticResource SoftCaption}" VerticalAlignment="Center"/>
                </Grid>
                <Border x:Name="QualityLoginHint" Grid.Row="1" Background="{DynamicResource HintBg}" BorderBrush="{DynamicResource HintBorder}" BorderThickness="1"
                        CornerRadius="7" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="9,5" ToolTip="登录后可重新扫描当前直播间的画质；实际可用画质仍由B站决定。">
                  <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource HintText}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="画质不完整？登录后重新解析" FontSize="12" Foreground="{DynamicResource HintText}" VerticalAlignment="Center"/>
                    <Button x:Name="QualityLoginHintButton" Content="扫码登录" Click="BiliLogin_Click" Background="{DynamicResource HintButtonBg}" Foreground="{DynamicResource HintButtonFg}"
                            MinHeight="29" Padding="10,5" FontWeight="SemiBold" FontSize="12" BorderThickness="0" Margin="9,0,0,0"/>
                  </WrapPanel>
                </Border>
              </Grid>
              <!-- Flexible filter tray: wrap rather than clip controls when sidebar is expanded. -->
              <Border Grid.Row="1" Background="{DynamicResource AltRowBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1" Padding="17,8">
                <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                  <TextBlock Text="画质" Style="{StaticResource SoftCaption}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <ComboBox x:Name="QualityChoice" Width="210" Margin="0,3,14,3" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="全部画质" Tag="all" IsSelected="True"/><ComboBoxItem Content="360P 流畅（参考）" Tag="80"/><ComboBoxItem Content="480P 高清（参考）" Tag="150"/><ComboBoxItem Content="720P 超清（参考）" Tag="250"/><ComboBoxItem Content="1080P 蓝光（参考）" Tag="400"/><ComboBoxItem Content="原画（实际规格待检测）" Tag="10000"/><ComboBoxItem Content="2K 极清（参考）" Tag="15000"/><ComboBoxItem Content="4K 超高清（待检测）" Tag="20000"/><ComboBoxItem Content="杜比（实际规格待检测）" Tag="30000"/>
                  </ComboBox>
                  <TextBlock Text="格式" Style="{StaticResource SoftCaption}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <ComboBox x:Name="FormatChoice" Width="144" Margin="0,3,14,3" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="全部格式" Tag="all" IsSelected="True"/><ComboBoxItem Content="HTTP-FLV" Tag="flv"/><ComboBoxItem Content="HLS / TS" Tag="ts"/><ComboBoxItem Content="HLS / fMP4" Tag="fmp4"/>
                  </ComboBox>
                  <TextBlock Text="编码" Style="{StaticResource SoftCaption}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <ComboBox x:Name="CodecChoice" Width="135" Margin="0,3,0,3" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="全部编码" Tag="all" IsSelected="True"/><ComboBoxItem Content="H.264" Tag="avc"/><ComboBoxItem Content="H.265" Tag="hevc"/>
                  </ComboBox>
                </WrapPanel>
              </Border>
              <Grid Grid.Row="2" ClipToBounds="True">
                <DataGrid x:Name="StreamGrid" BorderThickness="0" SelectionChanged="StreamGrid_SelectionChanged" MouseDoubleClick="StreamGrid_MouseDoubleClick" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="画质（QN）" Binding="{Binding QualityLabel}" Width="210"/>
                    <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="流格式" Binding="{Binding FormatLabel}" Width="95"/>
                    <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="编码" Binding="{Binding CodecLabel}" Width="104"/>
                    <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="CDN 线路" Binding="{Binding Host}" Width="*" MinWidth="160"/>
                    <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="分辨率" Binding="{Binding VideoSize}" Width="95"/>
                    <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="过期" Binding="{Binding ExpiresLabel}" Width="88"/>
                    <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="连接" Binding="{Binding TestStatus}" Width="100"/>
                  </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="StreamEmptyHint" Background="{DynamicResource CardBg}" Margin="1">
                  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=StreamGrid, Path=HasItems}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource AccentSoft}"><TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"/></Border>
                    <TextBlock Text="尚无直播线路" Margin="0,11,0,0" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="14"/>
                    <TextBlock Text="输入房间号并点击解析，即可选择播放地址" Margin="0,5,0,0" Style="{StaticResource SoftCaption}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" Padding="18,12">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="线路操作" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="MonitorStatusText" Text="尚未开始智能监测" Foreground="{DynamicResource SubText}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="复制 URL" Click="Copy_Click"/>
                  <Button Content="智能播放" Click="SmartPlay_Click"/>
                  <Button Content="使用 PotPlayer 播放" Style="{StaticResource PrimaryButton}" Click="Play_Click" Margin="0"/>
                </StackPanel>
              </Grid>
              <Expander Margin="0,9,0,0" IsExpanded="False"><Expander.Header><TextBlock Text="更多操作与原始地址" FontSize="12" Foreground="{DynamicResource SubText}"/></Expander.Header>
                <StackPanel Margin="0,9,0,0">
                  <TextBlock Text="原始地址可能包含时效签名，请勿公开分享" Style="{StaticResource SoftCaption}" Margin="0,0,0,6"/>
                  <TextBox x:Name="UrlPreview" MinHeight="45" MaxHeight="65" IsReadOnly="True" FontSize="12" FontFamily="Consolas" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                  <WrapPanel Margin="0,9,0,0">
                    <Button Content="保存地址" Click="SaveTxt_Click"/><Button Content="媒体信息" Click="MediaProbe_Click"/><Button Content="停止监测" Click="StopSmart_Click"/><Button Content="导出 M3U" Click="Export_Click"/><Button Content="代理播放" Click="ProxyPlay_Click"/><Button Content="复制代理地址" Click="ProxyCopy_Click"/>
                  </WrapPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
      <!-- Favorites -->
      <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="31" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/><TextBlock Text="收藏直播间" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><Grid Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,12"><TextBlock Text="我的收藏" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/><Button Content="刷新全部开播状态" Click="RefreshFav_Click"/><Button Content="打开选中直播间" Click="OpenFav_Click"/><Button Content="取消收藏" Click="RemoveFav_Click"/><Button Content="切换选中通知开关" Click="MuteFav_Click"/></WrapPanel>
        <DataGrid x:Name="FavoriteGrid" Grid.Row="1" MouseDoubleClick="FavoriteGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTemplateColumn Header="头像" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoft}" ClipToBounds="True"><Image Source="{Binding FaceUrl}" Width="34" Height="34" Stretch="UniformToFill"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="房间号" Binding="{Binding RoomId}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="主播" Binding="{Binding Name}" Width="150"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="直播标题" Binding="{Binding Title}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="开播状态" Binding="{Binding Status}" Width="105"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="开播时间" Binding="{Binding LiveTime}" Width="135"/><DataGridCheckBoxColumn Header="免打扰" Binding="{Binding Muted}" Width="82"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="检查时间" Binding="{Binding CheckedText}" Width="125"/></DataGrid.Columns></DataGrid>
        <TextBlock Grid.Row="2" Text="定时检查仅在客户端运行时进行。开播通知使用 Windows 系统托盘；首次检查不会误发开播提醒。" FontSize="12" Foreground="{DynamicResource SubText}" Margin="0,10,0,0"/>
      </Grid></TabItem>
      <!-- Search -->
      <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="31" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/><TextBlock Text="搜索直播" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><Grid Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBox x:Name="SearchInput" Width="360" ToolTip="主播或直播间关键词"/><Button Content="搜索 B站直播间" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Search_Click"/><Button Content="浏览器搜索" Click="BrowserSearch_Click"/></StackPanel><DataGrid x:Name="SearchGrid" Grid.Row="1" MouseDoubleClick="SearchGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="房间号" Binding="{Binding RoomId}" Width="130"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="主播" Binding="{Binding Uname}" Width="190"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="标题" Binding="{Binding Title}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="状态" Binding="{Binding StatusLabel}" Width="120"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Foreground="{DynamicResource SubText}" Margin="0,10,0,0" Text="关键词搜索依赖 B站 WBI 接口；如返回鉴权或限流错误，可使用浏览器搜索或输入房间号。"/></Grid></TabItem>
      <!-- PotPlayer danmaku companion: separate real-time stream, not a duplicate of playback analysis. -->
      <TabItem x:Name="DanmakuTab"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="29" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/><TextBlock Text="弹幕伴侣" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header>
        <Grid Margin="25,20,25,19">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
