      <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="31" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/><TextBlock Text="播放历史" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><Grid Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,12"><TextBlock Text="播放与操作历史" FontSize="23" FontWeight="SemiBold" Margin="0,0,16,0"/><Button Content="回到选中直播间" Click="HistoryOpen_Click"/><Button Content="清空历史" Click="HistoryClear_Click"/></WrapPanel><DataGrid x:Name="HistoryGrid" Grid.Row="1" MouseDoubleClick="HistoryGrid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="时间" Binding="{Binding TimeText}" Width="155"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="房间号" Binding="{Binding RoomId}" Width="120"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="标题" Binding="{Binding Title}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="操作" Binding="{Binding Action}" Width="150"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="格式" Binding="{Binding Format}" Width="125"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <!-- Quality matrix and actionable diagnostics (replaces redundant embedded web preview) -->
      <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="31" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/><TextBlock Text="画质矩阵" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header>
        <Grid Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="画质与直播源诊断" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource MainText}"/>
