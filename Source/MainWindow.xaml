              <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="实际返回画质" Binding="{Binding ActualQualities}" Width="310"/>
              <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="源数量" Binding="{Binding StreamCount}" Width="82"/>
              <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="格式" Binding="{Binding Formats}" Width="155"/>
              <DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="说明 / 错误" Binding="{Binding Detail}" Width="*" MinWidth="220"/></DataGrid.Columns>
          </DataGrid></Border>
