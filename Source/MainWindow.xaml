      <!-- Batch -->
      <TabItem><TabItem.Header><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="31" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/><TextBlock Text="批量与 M3U" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/></StackPanel></TabItem.Header><Grid Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="175"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="批量解析与播放列表" FontWeight="SemiBold" FontSize="25" Margin="0,0,0,10"/><TextBox x:Name="BatchInput" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Text="" ToolTip="每行一个房间号或直播间链接；空白时使用收藏列表"/>
        <WrapPanel Grid.Row="2" Margin="0,13,0,12"><Button Content="获取列表" Style="{StaticResource PrimaryButton}" Click="BatchFetch_Click"/><Button Content="从收藏填入" Click="FillBatch_Click"/><Button Content="导出原始 M3U" Click="BatchExport_Click"/><Button Content="导出本地固定 M3U" Click="BatchProxyExport_Click"/><Button Content="清空结果" Click="BatchClear_Click"/></WrapPanel>
        <DataGrid x:Name="BatchGrid" Grid.Row="3"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="房间号" Binding="{Binding RoomId}" Width="125"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="标题" Binding="{Binding Title}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="格式" Binding="{Binding Format}" Width="140"/><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="处理状态" Binding="{Binding Action}" Width="150"/></DataGrid.Columns></DataGrid>
      </Grid></TabItem>
