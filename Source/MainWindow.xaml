          <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="0"><DataGrid x:Name="QualityGrid" BorderThickness="0" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource ReadableGridText}" Header="请求画质" Binding="{Binding RequestedLabel}" Width="205"/>
